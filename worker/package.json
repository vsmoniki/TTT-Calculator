{
  "name": "ttt-calculator-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute ttt-calculator --local --file=migrations/0001_schema.sql",
    "db:seed:local": "wrangler d1 execute ttt-calculator --local --file=migrations/0002_seed.sql",
    "db:migrate:remote": "wrangler d1 execute ttt-calculator --remote --file=migrations/0001_schema.sql",
    "db:seed:remote": "wrangler d1 execute ttt-calculator --remote --file=migrations/0002_seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.101.0"
  }
}
